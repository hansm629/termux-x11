    <string name="lorie_pref_desktopModeDpiScale">데스크탑 모드 Xft DPI 배율</string>
    <string name="lorie_pref_desktopModeDpiScale_summary">외부 디스플레이/DeX 데스크탑 모드에서 사용할 Xft DPI 배율입니다.</string>
