+    retired->gpu_copy_serial = vblank->gpu_copy_serial;
+    retired->gpu_copy_dst_buffer = vblank->gpu_copy_dst_buffer;
+    retired->pixmap = vblank->pixmap;
+    retired->window = idle ? vblank->window : NULL;
