+struct present_retired_copy {
+    struct xorg_list    link;
+    uint64_t            gpu_copy_serial;
+    void                *gpu_copy_dst_buffer;
+    PixmapPtr           pixmap;
+    WindowPtr           window;
+    uint32_t            serial;
+    present_fence_ptr   idle_fence;
+    Bool                idle;
